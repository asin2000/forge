{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge:contracts:state:workflow_state.v2",
  "title": "Workflow state document (Firestore, internal)",
  "description": "NOT a bus message. Firestore document keyed by workflow_id (ORC-5). Status values BLOCKED_AGENT_FAILURE, AWAITING_RELEASE_APPROVAL, RELEASED are spec-named; others are implementation-defined. v2 adds trace_id: the workflow's ROOT trace (32-hex OTel mirror, OBS-1) so unattended producers (Logical Clock due events, ORC-4 monitor) derive their trace from the workflow itself, never from a caller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "status",
    "logical_time",
    "due_at",
    "equipment_id",
    "updated_observed_at",
    "trace_id"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "pattern": "^wf-[a-z0-9][a-z0-9-]{2,62}$"
    },
    "status": {
      "enum": [
        "INTAKE",
        "PLANNING",
        "VALIDATING",
        "AWAITING_SCHEDULE_APPROVAL",
        "SUSPENDED_AWAITING_PART",
        "ASSEMBLY_RESUMED",
        "AWAITING_RELEASE_APPROVAL",
        "RELEASED",
        "BLOCKED_AGENT_FAILURE"
      ]
    },
    "logical_time": {
      "type": "integer",
      "minimum": 0
    },
    "due_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "equipment_id": {
      "type": "string",
      "pattern": "^GX12-(0[1-9]|1[0-2])$"
    },
    "updated_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
